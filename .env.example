# Supabase Cloud Project Configuration (Docker-Free Environment)
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PostgreSQL Direct Connection String (For Cloud DB Migrations / psql / MCP)
# Database Password set in Supabase Dashboard Project Settings -> Database
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Edge Function Secret Overrides (Local native Deno testing)
DENO_REGION=us-east-1

# YouTube Data API (youtube-sync edge function — ADR 0004)
YOUTUBE_API_KEY=your-youtube-data-api-v3-key
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxxxx
# Optional cap per run (default 50, max 50/page x 3 pages)
YOUTUBE_MAX_RESULTS=50
